# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Public origin of the web app (used for links in emails and the OAuth redirect)
APP_ORIGIN=http://localhost:3000
# Comma-separated origins allowed to make state-changing requests
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────
# Neon / any PostgreSQL connection string. When unset in development, an embedded
# PGlite database (real Postgres compiled to WASM) is stored in ./.pglite.
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/fitmatch?sslmode=require
PGLITE_DIR=./.pglite

# ── Seed ────────────────────────────────────────────────
# Admin account created by `npm run db:seed`. If ADMIN_PASSWORD is empty, a random
# password is generated and printed once.
ADMIN_EMAIL=admin@fitmatch.local
ADMIN_PASSWORD=

# ── Google OAuth (optional) ─────────────────────────────
# Redirect URI to register: ${APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (optional, admin image uploads) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Recommendation engine ───────────────────────────────
# "deterministic" (built-in) or "remote" (POSTs to RECOMMENDER_URL, falls back to deterministic)
ENGINE_MODE=deterministic
RECOMMENDER_URL=
